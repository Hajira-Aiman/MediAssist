# Copy to .env and fill in as needed.
# The Streamlit app runs without any of these; they are only used by the
# optional LLM / training paths.

ENV=development
LOG_LEVEL=INFO

# Model paths
MODEL_PATH=./models/classical
VECTOR_STORE_PATH=./vector_store

# Optional external providers
HF_TOKEN=
OLLAMA_HOST=http://localhost:11434
